{
  "name": "homebridge-balboa-esp32",
  "displayName": "Balboa ESP32",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "description": "Homebridge plugin for older Balboa hot tub controllers, using an ESP32/ESPHome topside interface.",
  "author": "Emil-Peter Sosnowski",
  "license": "MIT",
  "homepage": "https://github.com/sixer-fixer/homebridge-balboa-esp32#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sixer-fixer/homebridge-balboa-esp32.git"
  },
  "bugs": {
    "url": "https://github.com/sixer-fixer/homebridge-balboa-esp32/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "balboa",
    "esp32",
    "esphome",
    "hot-tub",
    "spa",
    "homekit"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "homebridge-lib": "^8.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
